table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Number]

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: [Month Name]
		sortByColumn: 'Month Number'

	column 'Year Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year Month Number]

	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Number'

	column 'Day Type Sort'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Day Type Sort]

	column 'Day Type'
		dataType: string
		summarizeBy: none
		sourceColumn: [Day Type]
		sortByColumn: 'Day Type Sort'

	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2025, 9, 30 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Name", FORMAT ( [Date], "MMMM" ),
				    "Year Month Number", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Year Month", FORMAT ( [Date], "yyyy-MM" ),
				    "Day Type Sort", IF ( WEEKDAY ( [Date], 2 ) > 5, 2, 1 ),
				    "Day Type", IF ( WEEKDAY ( [Date], 2 ) > 5, "Weekend", "Weekday" )
				)
