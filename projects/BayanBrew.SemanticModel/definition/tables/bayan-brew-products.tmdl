table 'bayan-brew-products'

	column ProductID
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: ProductID

	column ProductName
		dataType: string
		summarizeBy: none
		sourceColumn: ProductName

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column BasePriceSmall
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: BasePriceSmall

	partition 'bayan-brew-products' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("D:/Acer/Documents V2/Projects/Power BI Introduction/data/bayan-brew/bayan-brew-products.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					ChangedType = Table.TransformColumnTypes(PromotedHeaders, {{"ProductID", type text}, {"ProductName", type text}, {"Category", type text}, {"BasePriceSmall", type number}})
				in
					ChangedType

