table 'bayan-brew-transactions'

	/// Sum of line revenue. Responds to slicers.
	measure 'Total Revenue' = SUM ( 'bayan-brew-transactions'[LineRevenuePHP] )
		formatString: "₱#,0.00"

	/// Distinct receipts. One order can have several lines.
	measure 'Total Orders' = DISTINCTCOUNT ( 'bayan-brew-transactions'[OrderID] )
		formatString: #,0

	/// Revenue divided by distinct orders.
	measure 'Average Order Value' = DIVIDE ( [Total Revenue], [Total Orders] )
		formatString: "₱#,0.00"

	/// Units sold on the line.
	measure 'Total Quantity' = SUM ( 'bayan-brew-transactions'[Quantity] )
		formatString: #,0

	/// Revenue divided by how many dates are in the current filter.
	measure 'Average Daily Revenue' = DIVIDE ( [Total Revenue], DISTINCTCOUNT ( 'Date'[Date] ) )
		formatString: "₱#,0.00"

	/// Orders divided by how many dates are in the current filter.
	measure 'Average Daily Orders' = DIVIDE ( [Total Orders], DISTINCTCOUNT ( 'Date'[Date] ) )
		formatString: #,0.0

	column OrderID
		dataType: string
		summarizeBy: none
		sourceColumn: OrderID

	column OrderDate
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: OrderDate

	column OrderTime
		dataType: string
		summarizeBy: none
		sourceColumn: OrderTime

	column StoreID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: StoreID

	column ProductID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ProductID

	column Size
		dataType: string
		summarizeBy: none
		sourceColumn: Size

	column Quantity
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Quantity

	column UnitPricePHP
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: UnitPricePHP

	column LineRevenuePHP
		dataType: double
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: LineRevenuePHP

	partition 'bayan-brew-transactions' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("D:/Acer/Documents V2/Projects/Power BI Introduction/data/bayan-brew/bayan-brew-transactions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					ChangedType = Table.TransformColumnTypes(PromotedHeaders, {{"OrderID", type text}, {"OrderDate", type date}, {"OrderTime", type text}, {"StoreID", type text}, {"ProductID", type text}, {"Size", type text}, {"Quantity", Int64.Type}, {"UnitPricePHP", type number}, {"LineRevenuePHP", type number}})
				in
					ChangedType

